<?xml version="1.0" encoding="UTF-8"?>
<!-- Configuración Maven del proyecto web LaEsquinaWebEV02. -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- Identificación del proyecto. -->
    <groupId>com.laesquina</groupId>
    <artifactId>laesquina-web-ev02</artifactId>
    <version>1.0.0</version>
    <packaging>war</packaging>

    <name>LaEsquinaWebEV02</name>

    <properties>
        <!-- Utilizar Java 21 y codificación UTF-8. -->
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- API de Servlets que proporciona Tomcat 10.1. -->
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <version>6.0.0</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- Nombre del archivo WAR generado. -->
        <finalName>LaEsquinaWebEV02</finalName>

        <plugins>
            <!-- Compilar el código fuente Java. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>

            <!-- Empaquetar la aplicación para Tomcat. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-war-plugin</artifactId>
                <version>3.4.0</version>
                <configuration>
                    <failOnMissingWebXml>false</failOnMissingWebXml>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
